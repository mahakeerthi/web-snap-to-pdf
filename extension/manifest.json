{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "128",
  "permissions": ["debugger", "activeTab", "scripting", "downloads", "storage", "contextMenus"],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  },
  "commands": {
    "save-pdf": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "__MSG_cmdSavePdf__"
    },
    "save-article": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "__MSG_cmdSaveArticle__"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
