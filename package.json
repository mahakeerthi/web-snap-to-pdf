{
  "name": "web-snap-to-pdf",
  "version": "0.0.0",
  "private": true,
  "description": "Chrome extension that converts the current web page to a PDF locally using Chrome's own print engine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahakeerthi/web-snap-to-pdf.git"
  },
  "homepage": "https://github.com/mahakeerthi/web-snap-to-pdf#readme",
  "bugs": {
    "url": "https://github.com/mahakeerthi/web-snap-to-pdf/issues"
  },
  "type": "module",
  "scripts": {
    "test": "node test/e2e.mjs",
    "test:content": "node test/content.e2e.mjs",
    "test:ui": "node scripts/screenshot-ui.mjs",
    "test:all": "npm test && npm run test:content && npm run test:ui",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:locales": "node scripts/check-locales.mjs",
    "check": "npm run lint && npm run format:check && npm run check:locales",
    "package": "node scripts/package.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "test:release": "node --test test/release.test.mjs",
    "version": "node scripts/sync-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.1"
    }
  }
}
